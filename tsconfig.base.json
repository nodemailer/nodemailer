{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],
        "useDefineForClassFields": false,
        "types": ["node"],
        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "erasableSyntaxOnly": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true
    }
}
